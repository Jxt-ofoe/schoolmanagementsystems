# ---------------------------------------------------------------------------
# Frontend (Vite) — these are PUBLIC values and end up in the browser bundle.
# ---------------------------------------------------------------------------
# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=
# Supabase anon / publishable key (safe for the browser; RLS protects data)
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# NEVER put these in a VITE_ variable or commit them. They are set as
# Supabase Edge Function secrets (supabase secrets set ...) only.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=      (provided automatically to Edge Functions by Supabase)
# SITE_URL=https://your-app.vercel.app
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ---------------------------------------------------------------------------
# Tests (optional) — direct Postgres connection to a DEVELOPMENT database.
# DB tests run inside transactions that are rolled back.
# ---------------------------------------------------------------------------
# TEST_DB_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# ---------------------------------------------------------------------------
# SaaS Shared SMS Gateway Configuration
# ---------------------------------------------------------------------------
# The single shared telecom-approved Sender ID for your SaaS platform (Max 11 alphanumeric chars)
PLATFORM_SMS_SENDER_ID=SchoolMS
# SMS Gateway Provider: 'arkesel' or 'hubtel' or 'custom'
PLATFORM_SMS_PROVIDER=arkesel
# Platform SMS Gateway API Key (e.g. from arkesel.com)
PLATFORM_SMS_API_KEY=
# Hubtel API Client Secret (if using Hubtel)
PLATFORM_SMS_API_SECRET=
# Estimated cost per unit in GHS
PLATFORM_SMS_RATE=0.05

# ---------------------------------------------------------------------------
# Paystack Payment Gateway Configuration
# ---------------------------------------------------------------------------
# Public key for frontend checkout popup (safe for browser)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack Secret Key for server-side verification and recurring charges (KEEP SECRET, serverless/backend only)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Paystack Webhook Signing Secret (defaults to PAYSTACK_SECRET_KEY if not set separately)
PAYSTACK_WEBHOOK_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Explicit Payment Simulation Flag (Finding M-6)
# Optional: Set to 'true' in local development or preview environments ONLY to simulate
# successful checkout/verification when PAYSTACK_SECRET_KEY is not configured.
# Strictly forbidden and ignored in production (NODE_ENV=production).
PAYMENT_SIMULATION=false

