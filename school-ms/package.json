{
  "name": "school-ms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "vitest run",
    "local:setup": "bash scripts/local-stack/setup.sh",
    "local:start": "bash scripts/local-stack/start.sh",
    "local:seed": "node scripts/local-stack/seed-demo.mjs",
    "local:reset": "bash scripts/local-stack/reset-db.sh",
    "db:backup": "node scripts/backup-db.cjs",
    "db:restore": "node scripts/restore-db.cjs",
    "db:schema": "node scripts/generate-full-schema.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "@tanstack/react-query": "^5.104.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "pg": "^8.23.1",
    "typescript": "5.6",
    "vite": "^6.4.5",
    "vitest": "^2.1.9",
    "ws": "^8.22.0"
  }
}
